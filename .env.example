# Copy to .env.local for local dev. Nothing here is required in dev - the
# app falls back to an in-memory store. REDIS_URL is required in production.

# Upstash (or any) Redis connection string. Without this in production the
# app refuses to start (see src/lib/store.ts).
REDIS_URL=

# Public URL of this deployment, used for CORS and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
