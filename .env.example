# Copy to .env.local for local dev. Nothing here is required in dev - the
# app falls back to an in-memory store. REDIS_URL is required in production.

# Upstash (or any) Redis connection string. Without this in production the
# app refuses to start (see src/lib/store.ts).
REDIS_URL=

# Public URL of this deployment, used for CORS and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign player session cookies. Required in production (see
# src/lib/session.ts). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Neon Postgres connection string. Optional - without it, sign-in (#37/#38)
# silently no-ops and gameplay is unaffected. See src/lib/db.ts.
DATABASE_URL=

# Secret BetterAuth uses to sign its own sessions/cookies. Generate with:
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# Discord OAuth app credentials, for "Sign in with Discord" (#38). Without
# these, anonymous sessions still work but Discord sign-in fails.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
